# ============================================================================
# OmniDesk AI - environment configuration (Phase 1)
# Copy to .env and adjust. .env is git-ignored and must NEVER be committed.
# ============================================================================

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (consumed by the Docker "db" service) ---
POSTGRES_USER=omnidesk
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=omnidesk

# --- Backend database connection (async SQLAlchemy / asyncpg) ---
# Host "db" refers to the Docker Compose service name.
DATABASE_URL=postgresql+asyncpg://omnidesk:change_me_local_dev@db:5432/omnidesk

# --- CORS: browser origin(s) for the local Next.js frontend (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (Phase 2): signing secret for session JWTs (use a long random value) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# COOKIE_SECURE=false          # set true in production (HTTPS)

# --- Encryption (Phase 4): Fernet key for encrypting stored provider API keys ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMNIDESK_MASTER_KEY=generate-a-fernet-key-and-put-it-here
# Optional server-wide OpenAI fallback key (users can also add their own in the UI):
OPENAI_API_KEY=

# ============================================================================
# Reserved for later phases - listed for reference, NOT used yet.
# (Kept server-side only; never exposed to the frontend.)
# ============================================================================
# OMNIDESK_MASTER_KEY=         # Phase 4: AES-256-GCM provider-key encryption at rest
# FILE_STORAGE_DIR=./storage   # Phase 9: uploaded file storage
# OPENAI_API_KEY=              # Phase 4: optional server-default provider key
# GEMINI_API_KEY=              # Phase 5
# ANTHROPIC_API_KEY=           # Phase 5
